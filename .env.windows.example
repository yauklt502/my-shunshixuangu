# Windows + miniQMT 环境变量模板
# 复制为 .env 后按你的券商安装路径修改

# --- A层：研究 ---
TUSHARE_TOKEN=your_tushare_token_here

# --- B层：miniQMT（按券商实际路径修改）---
# 常见路径示例：
#   国金：D:\国金QMT交易端\userdata_mini
#   其他：D:\证券QMT交易端\userdata_mini
QMT_INSTALL_DIR=D:\国金QMT交易端
QMT_PATH=D:\国金QMT交易端\userdata_mini
QMT_ACCOUNT=88888888
QMT_ACCOUNT_TYPE=STOCK
QMT_XTQUANT_SITE_PACKAGES=D:\国金QMT交易端\bin.x64\Lib\site-packages
QMT_MCP_DIR=C:\Tools\qmt-mcp-server
QMT_MCP_API_TOKEN=change-me-to-a-strong-secret
QMT_MCP_PORT=8765

# --- C层：自建数据 ---
MY_DATA_MCP_TOKEN=change-me-to-a-strong-secret
