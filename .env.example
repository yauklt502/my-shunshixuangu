# 顺时选股 - 环境变量配置（可选）
# 复制为 .env 后按需修改

# 行情数据源: eastmoney | tushare | mootdx | ths | mock
DATA_SOURCE=eastmoney

# Tushare Token（可选）
# TUSHARE_TOKEN=your_token_here

# 券商类型: mock | rest | easytrader
BROKER_TYPE=mock

# REST 券商网关（BROKER_TYPE=rest 时使用）
# BROKER_API_URL=http://127.0.0.1:9000
# BROKER_API_TOKEN=your_token

# 同花顺 API（可选）
# THS_API_URL=
# THS_API_TOKEN=
