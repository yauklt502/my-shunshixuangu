# Copy to ~/.cursor/mcp.json (global) or .cursor/mcp.json (project-local)
# Then replace placeholder values below.

# --- A层：行情/研究 ---
TUSHARE_TOKEN=your_tushare_token_here
ASHARE_MCP_AUTH_TOKEN=optional_ashare_http_token

# --- B层：券商/量化（本机 miniQMT / 掘金） ---
QMT_MCP_API_TOKEN=your_qmt_mcp_api_token
QMT_PATH=/path/to/miniqmt/userdata_mini
QMT_ACCOUNT=your_fund_account

# --- C层：自建数据服务 ---
MY_DATA_MCP_TOKEN=change-me-to-a-strong-secret
MY_DATA_DB_URL=sqlite:///./data/factors.db
